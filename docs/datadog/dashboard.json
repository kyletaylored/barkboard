{
  "title": "Barkboard Device Monitoring",
  "description": "Monitoring dashboard for Barkboard IoT devices — heap memory, system health, and connectivity.",
  "widgets": [
    {
      "definition": {
        "type": "image",
        "url": "https://kyletaylored.com/barkboard/assets/barkboard-logo.png",
        "sizing": "cover",
        "margin": "sm",
        "has_background": false,
        "has_border": true,
        "vertical_align": "center",
        "horizontal_align": "center"
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 3,
        "height": 2
      }
    },
    {
      "definition": {
        "title": "Time Since Last Reboot",
        "type": "query_value",
        "requests": [
          {
            "aggregator": "last",
            "queries": [
              {
                "data_source": "metrics",
                "name": "query1",
                "query": "avg:barkboard.uptime{$device,$firmware_version}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "query1"
              }
            ],
            "response_format": "scalar",
            "conditional_formats": [
              {
                "comparator": "<=",
                "value": 300,
                "palette": "white_on_red"
              },
              {
                "comparator": "<=",
                "value": 3600,
                "palette": "white_on_yellow"
              },
              {
                "comparator": ">",
                "value": 3600,
                "palette": "white_on_green"
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 0
      },
      "layout": {
        "x": 3,
        "y": 0,
        "width": 3,
        "height": 2
      }
    },
    {
      "definition": {
        "title": "Heap Used %",
        "type": "query_value",
        "requests": [
          {
            "aggregator": "last",
            "queries": [
              {
                "data_source": "metrics",
                "name": "query1",
                "query": "avg:barkboard.heap.used_pct{$device,$firmware_version}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "query1"
              }
            ],
            "response_format": "scalar",
            "conditional_formats": [
              {
                "comparator": ">",
                "value": 90,
                "palette": "white_on_red"
              },
              {
                "comparator": ">",
                "value": 75,
                "palette": "white_on_yellow"
              },
              {
                "comparator": ">=",
                "value": 0,
                "palette": "white_on_green"
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 1
      },
      "layout": {
        "x": 6,
        "y": 0,
        "width": 3,
        "height": 2
      }
    },
    {
      "definition": {
        "title": "WiFi RSSI (dBm)",
        "type": "query_value",
        "requests": [
          {
            "aggregator": "last",
            "conditional_formats": [
              {
                "comparator": "<",
                "palette": "white_on_red",
                "value": -80
              },
              {
                "comparator": "<",
                "palette": "white_on_yellow",
                "value": -70
              },
              {
                "comparator": ">=",
                "palette": "white_on_green",
                "value": -70
              }
            ],
            "formulas": [
              {
                "formula": "query1"
              }
            ],
            "queries": [
              {
                "aggregator": "last",
                "data_source": "metrics",
                "name": "query1",
                "query": "avg:barkboard.wifi.rssi{$device,$firmware_version}"
              }
            ],
            "response_format": "scalar"
          }
        ],
        "autoscale": false,
        "precision": 0
      },
      "layout": {
        "x": 9,
        "y": 0,
        "width": 3,
        "height": 2
      }
    },
    {
      "definition": {
        "title": "Heap Memory",
        "background_color": "blue",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Heap Size vs Free vs Min Free",
              "show_legend": true,
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "alias": "Total Size",
                      "formula": "query1"
                    },
                    {
                      "alias": "Free",
                      "formula": "query2"
                    },
                    {
                      "alias": "Min Free (Watermark)",
                      "formula": "query3"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:barkboard.heap.size{$device,$firmware_version}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "avg:barkboard.heap.free{$device,$firmware_version}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query3",
                      "query": "avg:barkboard.heap.min_free{$device,$firmware_version}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Heap Max Allocatable Block",
              "show_legend": true,
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:barkboard.heap.max_alloc{$device,$firmware_version}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Heap Used %",
              "show_legend": true,
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:barkboard.heap.used_pct{$device,$firmware_version}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "label": "Critical",
                  "value": "y = 90",
                  "display_type": "error dashed"
                },
                {
                  "label": "Warning",
                  "value": "y = 75",
                  "display_type": "warning dashed"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 12,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Heap Fragmentation %",
              "show_legend": true,
              "type": "timeseries",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:barkboard.heap.free{$device,$firmware_version}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "avg:barkboard.heap.max_alloc{$device,$firmware_version}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "(query1 - query2) / query1 * 100",
                      "alias": "Fragmentation %"
                    }
                  ],
                  "response_format": "timeseries",
                  "style": {
                    "palette": "orange"
                  },
                  "display_type": "area"
                }
              ],
              "yaxis": {
                "scale": "linear",
                "min": "0",
                "max": "100"
              },
              "markers": [
                {
                  "label": "High Fragmentation",
                  "value": "y = 50",
                  "display_type": "error dashed"
                },
                {
                  "label": "Moderate",
                  "value": "y = 25",
                  "display_type": "warning dashed"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 6,
              "width": 12,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 2,
        "width": 12,
        "height": 10
      }
    },
    {
      "definition": {
        "title": "System and Connectivity",
        "background_color": "green",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Device Online Status",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value",
                "sum"
              ],
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1 / query1",
                      "alias": "Online"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:barkboard.uptime{$device,$firmware_version} by {device}"
                    }
                  ],
                  "response_format": "timeseries",
                  "style": {
                    "palette": "green",
                    "line_type": "solid",
                    "line_width": "normal"
                  },
                  "display_type": "area"
                }
              ],
              "yaxis": {
                "min": "0",
                "max": "1.5"
              }
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Task Stack Free",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value",
                "sum"
              ],
              "time": {},
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:barkboard.task.stack_free{$device,$firmware_version} by {task}"
                    }
                  ],
                  "response_format": "timeseries",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  },
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 4,
              "y": 0,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "WiFi RSSI",
              "show_legend": true,
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:barkboard.wifi.rssi{$device,$firmware_version}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "label": "Poor Signal",
                  "value": "y = -80",
                  "display_type": "error dashed"
                },
                {
                  "label": "Fair Signal",
                  "value": "y = -70",
                  "display_type": "warning dashed"
                }
              ]
            },
            "layout": {
              "x": 8,
              "y": 0,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Task Busy %",
              "show_legend": true,
              "type": "timeseries",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:barkboard.task.busy_pct{$device,$firmware_version} by {task}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "label": "Critical",
                  "value": "y = 95",
                  "display_type": "error dashed"
                },
                {
                  "label": "Warning",
                  "value": "y = 80",
                  "display_type": "warning dashed"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 12,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "API Calls by Endpoint",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "sum",
                "avg",
                "max"
              ],
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:barkboard.api.calls{$device,$firmware_version} by {endpoint}.as_count()"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 6,
              "width": 12,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 12,
        "width": 12,
        "height": 10,
        "is_column_break": true
      }
    },
    {
      "definition": {
        "title": "Device Events",
        "background_color": "orange",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Barkboard Events",
              "time": {},
              "requests": [
                {
                  "query": {
                    "query_string": "service:barkboard source:my_apps",
                    "data_source": "event_stream",
                    "event_size": "l"
                  },
                  "columns": [],
                  "response_format": "event_list"
                }
              ],
              "type": "list_stream"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 4
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 22,
        "width": 6,
        "height": 5
      }
    },
    {
      "definition": {
        "title": "Fleet Inventory",
        "background_color": "purple",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Device Fleet Status",
              "type": "query_table",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:barkboard.uptime{$device,$firmware_version} by {device}",
                      "aggregator": "last"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "avg:barkboard.wifi.rssi{$device,$firmware_version} by {device}",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar",
                  "sort": {
                    "count": 25,
                    "order_by": [
                      {
                        "type": "formula",
                        "index": 0,
                        "order": "desc"
                      }
                    ]
                  },
                  "formulas": [
                    {
                      "formula": "query1",
                      "alias": "Uptime (s)",
                      "conditional_formats": [
                        {
                          "comparator": ">",
                          "value": 0,
                          "palette": "white_on_green"
                        },
                        {
                          "comparator": "<=",
                          "value": 0,
                          "palette": "white_on_red"
                        }
                      ]
                    },
                    {
                      "formula": "query2",
                      "alias": "WiFi RSSI (dBm)",
                      "conditional_formats": [
                        {
                          "comparator": "<",
                          "value": -80,
                          "palette": "white_on_red"
                        },
                        {
                          "comparator": "<",
                          "value": -70,
                          "palette": "white_on_yellow"
                        },
                        {
                          "comparator": ">=",
                          "value": -70,
                          "palette": "white_on_green"
                        }
                      ]
                    }
                  ]
                }
              ],
              "has_search_bar": "auto"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 4
            }
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 22,
        "width": 6,
        "height": 5
      }
    }
  ],
  "template_variables": [
    {
      "name": "device",
      "prefix": "device",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "firmware_version",
      "prefix": "firmware_version",
      "available_values": [],
      "default": "*"
    }
  ],
  "layout_type": "ordered",
  "notify_list": [],
  "pause_auto_refresh": false,
  "reflow_type": "fixed",
  "tags": []
}